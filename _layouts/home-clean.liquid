---
# Standalone layout for the home/about page — bypasses al-folio navbar, footer,
# Bootstrap, and MDB. All content is here; about.md body is unused.
---
<!doctype html>
<html lang="{{ site.lang | default: 'en' }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Gabriel E. Lade</title>
    <meta name="description" content="{{ site.description | strip_html | normalize_whitespace | escape }}">
    <meta property="og:title" content="Gabriel E. Lade">
    <meta property="og:description" content="{{ site.description | strip_html | normalize_whitespace | escape }}">
    <meta property="og:image" content="{{ site.url }}/assets/img/lade-pic.jpeg">
    <meta property="og:url" content="{{ site.url }}/">
    <meta property="og:type" content="website">
    <meta name="twitter:card" content="summary">
    <link rel="canonical" href="{{ site.url }}/">
    <link rel="shortcut icon" href="{{ '/assets/img/favicon.svg' | relative_url }}">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
      href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,400;8..60,500;8..60,600;8..60,700&family=Public+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    >

    <style>
      :root {
        --ink: #1a1a19;
        --muted: #56534d;
        --faint: #8a8880;
        --accent: #bb0000;
        --link: #9a5a00;
        --bg: #fbfaf8;
        --hair: #e3ded5;
      }
      * {
        box-sizing: border-box;
      }
      html,
      body {
        margin: 0;
        padding: 0;
      }
      body {
        font-family:
          'Public Sans',
          system-ui,
          -apple-system,
          sans-serif;
        color: var(--ink);
        background: var(--bg);
        -webkit-font-smoothing: antialiased;
      }

      /* top: one quiet cross-link */
      .topbar {
        display: flex;
        justify-content: flex-end;
        max-width: 900px;
        margin: 0 auto;
        padding: 18px 40px 0;
      }
      .topbar a {
        font-size: 13px;
        color: var(--muted);
        text-decoration: none;
      }
      .topbar a:hover {
        color: var(--accent);
      }

      /* identity */
      .identity {
        max-width: 620px;
        margin: 0 auto;
        padding: 24px 40px 40px;
        text-align: center;
      }
      .identity img {
        width: 132px;
        height: 132px;
        object-fit: cover;
        border-radius: 8px;
        display: block;
        margin: 0 auto 22px;
      }
      .identity h1 {
        font-family: 'Source Serif 4', serif;
        font-weight: 600;
        font-size: 34px;
        letter-spacing: -0.02em;
        margin: 0 0 12px;
      }
      .role {
        font-size: 15.5px;
        line-height: 1.6;
        color: #3a3833;
        margin: 0;
      }
      .role.last {
        margin-bottom: 16px;
      }
      .affil {
        font-size: 13.5px;
        line-height: 1.6;
        color: var(--faint);
        margin: 0 0 4px;
      }
      .affil.last {
        margin-bottom: 20px;
      }
      .contact {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-wrap: wrap;
        gap: 12px 18px;
      }
      .contact a {
        font-size: 14px;
        color: #46443f;
        text-decoration: none;
        font-weight: 500;
      }
      .contact a:hover {
        color: var(--accent);
      }
      .contact .dot {
        color: #d3cec4;
      }
      .cv {
        font-size: 13.5px !important;
        font-weight: 600 !important;
        color: var(--accent) !important;
        border: 1px solid #e6b3b3;
        padding: 6px 14px;
        border-radius: 100px;
      }
      .cv:hover {
        background: #fbf2f2;
      }

      /* swank strip */
      .swank-wrap {
        max-width: 720px;
        margin: 0 auto;
        padding: 0 40px 20px;
      }
      .swank {
        display: block;
        text-decoration: none;
        border: 1px solid #eae6de;
        border-radius: 10px;
        background: #f5f1ea;
        padding: 16px 20px;
        color: #46443f;
      }
      .swank:hover {
        border-color: #dad6ce;
      }
      .swank .t {
        font-family: 'Source Serif 4', serif;
        font-weight: 600;
        font-size: 15.5px;
        color: var(--ink);
      }
      .swank .d {
        display: block;
        font-size: 13.5px;
        line-height: 1.5;
        color: #6c6a64;
        margin-top: 3px;
      }

      /* sections */
      .body {
        max-width: 720px;
        margin: 0 auto;
        padding: 20px 40px 8px;
      }
      .section {
        margin-bottom: 34px;
      }
      .section > h2 {
        font-family: 'Source Serif 4', serif;
        font-weight: 600;
        font-size: 15px;
        letter-spacing: 0.02em;
        text-transform: uppercase;
        color: var(--ink);
        margin: 0 0 4px;
        padding-bottom: 8px;
        border-bottom: 1px solid var(--hair);
      }
      .section-note {
        font-size: 13.5px;
        line-height: 1.55;
        color: #6c6a64;
        margin: 12px 0 0;
      }
      .section-note a {
        color: var(--accent);
        font-weight: 600;
        text-decoration: none;
      }
      .list {
        display: flex;
        flex-direction: column;
        gap: 18px;
        margin-top: 16px;
      }
      .courses {
        display: flex;
        flex-direction: column;
        gap: 9px;
        margin-top: 14px;
      }
      .course {
        font-size: 14.5px;
        line-height: 1.5;
        margin: 0;
      }
      .course a {
        color: var(--ink);
        text-decoration: none;
        font-weight: 600;
      }
      .course a:hover {
        color: var(--accent);
      }
      .course .inst {
        color: var(--faint);
      }

      .pub .title {
        font-family: 'Source Serif 4', serif;
        font-weight: 600;
        font-size: 16.5px;
        line-height: 1.35;
        color: var(--ink);
        text-decoration: none;
        display: block;
      }
      .pub .title:hover {
        color: var(--accent);
      }
      .pub .authors {
        font-size: 13.5px;
        line-height: 1.5;
        color: var(--muted);
        margin-top: 3px;
      }
      .pub .meta {
        font-size: 13.5px;
        line-height: 1.5;
        margin-top: 2px;
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 4px 10px;
        color: #6c6a64;
      }
      .pub .venue {
        color: #46443f;
        font-weight: 600;
      }
      .pub .xlinks {
        display: inline-flex;
        flex-wrap: wrap;
        gap: 8px;
      }
      .pub .xlinks a {
        font-family: 'IBM Plex Mono', monospace;
        font-size: 11.5px;
        color: var(--link);
        text-decoration: none;
      }
      .pub .xlinks a:hover {
        color: var(--accent);
      }

      .foot {
        max-width: 720px;
        margin: 0 auto;
        padding: 8px 40px 48px;
      }
      .foot p {
        font-size: 12.5px;
        color: #a5a199;
        border-top: 1px solid #e8e4dd;
        padding-top: 20px;
        margin: 0;
      }

      @media (max-width: 620px) {
        .identity,
        .swank-wrap,
        .body,
        .foot {
          padding-left: 24px;
          padding-right: 24px;
        }
      }
    </style>
  </head>
